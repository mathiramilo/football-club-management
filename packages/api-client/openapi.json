  "info": {
    "title": "Football Club Management API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "type": "http",
        "description": "Session token (mobile)"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Session cookie (web), `__Secure-` prefixed over HTTPS"
      }
    },
    "schemas": {
      "AppConfigResponse": {
        "type": "object",
        "properties": {
          "minimumVersions": {
            "type": "object",
            "properties": {
              "ios": {
                "nullable": true,
                "description": "The oldest version still served; null when every version is",
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
              },
              "android": {
                "nullable": true,
                "description": "The oldest version still served; null when every version is",
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
              },
              "web": {
                "nullable": true,
                "description": "The oldest version still served; null when every version is",
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
              }
            },
            "required": [
              "ios",
              "android",
              "web"
            ],
            "additionalProperties": false
          },
          "updateRequired": {
            "type": "boolean",
            "description": "Whether this request's X-App-Version is below the minimum for its X-Platform"
          },
          "storeUrls": {
            "type": "object",
            "properties": {
              "ios": {
                "nullable": true,
                "type": "string",
                "format": "uri"
              },
              "android": {
                "nullable": true,
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "ios",
              "android"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "minimumVersions",
          "updateRequired",
          "storeUrls"
        ],
        "additionalProperties": false
      },
      "LegalDocumentsResponse": {
        "type": "object",
        "properties": {
          "acceptanceRequired": {
            "type": "boolean",
            "description": "Whether any document must be accepted before anything else can be done"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalDocumentStatus"
            }
          }
        },
        "required": [
          "acceptanceRequired",
          "documents"
        ],
        "additionalProperties": false
      },
      "LegalDocumentStatus": {
        "type": "object",
        "properties": {
          "document": {
            "type": "string",
            "x-extensible-enum": [
              "terms",
              "privacy"
            ]
          },
          "version": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "The version in force: the one to accept"
          },
          "acceptedVersion": {
            "nullable": true,
            "description": "The latest version this user accepted; null when none",
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "acceptanceRequired": {
            "type": "boolean",
            "description": "Whether this user must accept the version in force (BR-AUTH-08)"
          }
        },
        "required": [
          "document",
          "version",
          "acceptedVersion",
          "acceptanceRequired"
        ],
        "additionalProperties": false
      },
      "AcceptLegalDocumentsBody": {
        "type": "object",
        "properties": {
          "documents": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "document": {
                  "type": "string",
                  "enum": [
                    "terms",
                    "privacy"
                  ]
                },
                "version": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                  "description": "The date the text came into force (YYYY-MM-DD)"
                }
              },
              "required": [
                "document",
                "version"
              ]
            }
          }
        },
        "required": [
          "documents"
        ]
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "firstName": {
            "nullable": true,
            "description": "Null until the profile is completed",
            "type": "string"
          },
          "lastName": {
            "nullable": true,
            "description": "Null until the profile is completed",
            "type": "string"
          },
          "nickname": {
            "nullable": true,
            "type": "string"
          },
          "birthdate": {
            "nullable": true,
            "description": "Null until the profile is completed",
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "displayName": {
            "nullable": true,
            "description": "The nickname, or the first name and last-name initial (BR-AUTH-07); null until the profile is completed",
            "type": "string"
          },
          "isMinor": {
            "nullable": true,
            "description": "Whether the user is 16 or 17 (BR-AUTH-05); null until the birthdate is set",
            "type": "boolean"
          },
          "profileComplete": {
            "type": "boolean",
            "description": "Whether the first name, last name and birthdate are set (AUTH-05)"
          },
          "photo": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/ProfilePhoto"
              }
            ]
          },
          "suggestedName": {
            "nullable": true,
            "description": "The name from Google or Apple, to prefill the form; null when there is none",
            "type": "object",
            "properties": {
              "firstName": {
                "type": "string"
              },
              "lastName": {
                "type": "string"
              }
            },
            "required": [
              "firstName",
              "lastName"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "nickname",
          "birthdate",
          "displayName",
          "isMinor",
          "profileComplete",
          "photo",
          "suggestedName"
        ],
        "additionalProperties": false
      },
      "ProfilePhoto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Changes with every new photo: a cache key for the image"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "512 × 512 WebP, signed; valid until expiresAt"
          },
          "thumbnailUrl": {
            "type": "string",
            "format": "uri",
            "description": "128 × 128 WebP, signed; valid until expiresAt"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "url",
          "thumbnailUrl",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "UpdateProfileBody": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "nickname": {
            "description": "Null or an empty string removes it",
            "nullable": true,
            "type": "string",
            "maxLength": 30
          },
          "birthdate": {
            "description": "Set once: after the first save only support can change it (F01 § 5)",
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        }
      },
      "CreateProfilePhotoUploadBody": {
        "type": "object",
        "properties": {
          "mimeType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 307200,
            "description": "The exact size of the file to upload; compressed on the device first (AUTH-05)"
          }
        },
        "required": [
          "mimeType",
          "sizeBytes"
        ]
      },
      "ProfilePhotoUploadResponse": {
        "type": "object",
        "properties": {
          "uploadKey": {
            "type": "string",
            "description": "Send it to PUT /v1/me/photo once the upload succeeds"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "method": {
            "type": "string",
            "enum": [
              "PUT"
            ]
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Send these headers with the upload"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "uploadKey",
          "url",
          "method",
          "headers",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "SetProfilePhotoBody": {
        "type": "object",
        "properties": {
          "uploadKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "uploadKey"
        ]
      },
      "CreateClubBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "shortName": {
            "description": "Shown in compact UI (BR-CLUB-01)",
            "nullable": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "countryCode": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$",
            "description": "ISO 3166-1 alpha-2"
          },
          "timezone": {
            "type": "string",
            "maxLength": 64,
            "description": "IANA time zone, e.g. America/Montevideo"
          },
          "primaryColor": {
            "nullable": true,
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "#rrggbb; clients keep text readable on it (UX § 7.1)"
          },
          "secondaryColor": {
            "nullable": true,
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "#rrggbb; clients keep text readable on it (UX § 7.1)"
          },
          "firstCategory": {
            "description": "The category the creator coaches; they become its DT from today (BR-ROLE-06)",
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2,
                "maxLength": 40
              },
              "format": {
                "description": "Default f11 (BR-CLUB-03)",
                "type": "string",
                "enum": [
                  "f11",
                  "f9",
                  "f8",
                  "f7",
                  "f5",
                  "futsal"
                ]
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "name",
          "countryCode",
          "timezone"
        ]
      },
      "MyClub": {
        "type": "object",
        "properties": {
          "club": {
            "$ref": "#/components/schemas/ClubSummary"
          },
          "membershipId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "isOwner": {
            "type": "boolean"
          },
          "isAdmin": {
            "type": "boolean",
            "description": "True for the Owner too (permission matrix § 4)"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MyCategoryRole"
            },
            "description": "Current memberships on the club calendar day, in non-archived categories"
          }
        },
        "required": [
          "club",
          "membershipId",
          "isOwner",
          "isAdmin",
          "categories"
        ],
        "additionalProperties": false
      },
      "ClubSummary": {
        "type": "object",
