{
  "openapi": "3.0.0",
  "paths": {
    "/v1/app-config": {
      "get": {
        "operationId": "appConfigGet",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppConfigResponse"
                }
              }
            }
          },
          "default": {
            "description": "Problem details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": [
          "platform"
        ],
        "security": []
      }
    }
  },
  "info": {
    "title": "Football Club Management API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "type": "http",
        "description": "Session token (mobile)"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Session cookie (web), `__Secure-` prefixed over HTTPS"
      }
    },
    "schemas": {
      "AppConfigResponse": {
        "type": "object",
        "properties": {
          "minimumVersions": {
            "type": "object",
            "properties": {
              "ios": {
                "nullable": true,
                "description": "The oldest version still served; null when every version is",
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
              },
              "android": {
                "nullable": true,
                "description": "The oldest version still served; null when every version is",
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
              },
              "web": {
                "nullable": true,
                "description": "The oldest version still served; null when every version is",
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
              }
            },
            "required": [
              "ios",
              "android",
              "web"
            ],
            "additionalProperties": false
          },
          "updateRequired": {
            "type": "boolean",
            "description": "Whether this request's X-App-Version is below the minimum for its X-Platform"
          },
          "storeUrls": {
            "type": "object",
            "properties": {
              "ios": {
                "nullable": true,
                "type": "string",
                "format": "uri"
              },
              "android": {
                "nullable": true,
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "ios",
              "android"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "minimumVersions",
          "updateRequired",
          "storeUrls"
        ],
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "x-extensible-enum": [
              "BAD_REQUEST",
              "VALIDATION_FAILED",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "SERVICE_UNAVAILABLE",
              "IDEMPOTENCY_KEY_REQUIRED",
              "IDEMPOTENCY_KEY_REUSED",
              "IDEMPOTENCY_REQUEST_IN_PROGRESS",
              "APP_UPDATE_REQUIRED"
            ]
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "in": {
                  "type": "string",
                  "x-extensible-enum": [
                    "body",
                    "query",
                    "path"
                  ]
                },
                "pointer": {
                  "type": "string",
                  "description": "JSON Pointer (RFC 6901) into that part of the request"
                },
                "code": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "in",
                "pointer",
                "code"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "additionalProperties": false
      }
    }
  },
  "security": [
    {
      "bearer": []
    },
    {
      "cookie": []
    }
  ]
}
