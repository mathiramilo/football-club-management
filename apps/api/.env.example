DATABASE_URL=postgresql://postgres:postgres@localhost:5432/football_club_management
PORT=3001
SHUTDOWN_DRAIN_MS=0
# json in every shared environment; pretty only reads better in a terminal.
LOG_LEVEL=info
LOG_FORMAT=pretty
MAILPIT_URL=http://localhost:8025
EMAIL_FROM=no-reply@example.test
API_BASE_URL=http://localhost:3001
# Local only: generate a real one with `openssl rand -base64 32` for any shared environment.
BETTER_AUTH_SECRET=local-development-secret-not-for-real-use
WEB_ORIGINS=http://localhost:3000
# Parent domain shared by the web app and the API (app. and api.), so the web app sees the session cookie.
# Leave empty locally: localhost shares cookies across ports.
AUTH_COOKIE_DOMAIN=
# Comma-separated OAuth client IDs: Google web, iOS and Android; Apple services ID, then bundle ID.
# Web sign-in redirects back to $API_BASE_URL/v1/auth/callback/google and /callback/apple; register both.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Web sign-in only; the apps send ID tokens. Google's web client secret, and Apple's Sign in with Apple
# key: its team ID, key ID and the .p8 contents with line breaks written as \n.
GOOGLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
AUTH_RATE_LIMIT_ENABLED=true
# CIDRs of the host's proxies, so the rate limiter reads the real client IP from X-Forwarded-For (TECH-02).
AUTH_TRUSTED_PROXIES=
