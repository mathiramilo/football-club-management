{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker --path tsconfig.worker.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "openapi": "node --enable-source-maps dist/write-openapi.js ../../packages/api-client/openapi.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@repo/contracts": "workspace:*",
    "@repo/i18n": "workspace:*",
    "better-auth": "1.7.12",
    "date-fns": "4.4.0",
    "intl-messageformat": "12.1.4",
    "nestjs-cls": "7.0.1",
    "pg-boss": "12.38.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@repo/config": "workspace:*",
    "@standard-schema/spec": "1.1.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.8",
    "eslint": "catalog:",
    "jose": "6.2.13",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "uuid": "14.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
