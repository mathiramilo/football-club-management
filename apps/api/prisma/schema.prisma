generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [btree_gist, citext, pg_trgm, unaccent]
}

model User {
  id                  String    @id @default(uuid(7)) @db.Uuid
  email               String    @unique @db.Citext
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.Timestamptz(6)
  firstName           String?   @map("first_name")
  lastName            String?   @map("last_name")
  nickname            String?
  birthdate           DateTime? @db.Date
  photoKey            String?   @map("photo_key")
  phone               String?
  locale              String    @default("es")
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz(6)
  purgeAt             DateTime? @map("purge_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clubMemberships ClubMembership[]

  @@map("users")
}

model Club {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  shortName       String?   @map("short_name")
  crestKey        String?   @map("crest_key")
  primaryColor    String?   @map("primary_color")
  secondaryColor  String?   @map("secondary_color")
  countryCode     String    @map("country_code")
  timezone        String
  defaultLocale   String    @default("es") @map("default_locale")
  quietHoursStart DateTime  @default(dbgenerated("'22:00:00'::time without time zone")) @map("quiet_hours_start") @db.Time(6)
  quietHoursEnd   DateTime  @default(dbgenerated("'08:00:00'::time without time zone")) @map("quiet_hours_end") @db.Time(6)
  aiEnabled       Boolean   @default(true) @map("ai_enabled")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  purgeAt         DateTime? @map("purge_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  categories          Category[]
  clubMemberships     ClubMembership[]
  categoryMemberships CategoryMembership[]
  venues              Venue[]
  events              Event[]
  eventCategories     EventCategory[]
  eventInvitees       EventInvitee[]
  rsvpChanges         RsvpChange[]

  @@map("clubs")
}

model Category {
  id                 String    @id @default(uuid(7)) @db.Uuid
  clubId             String    @map("club_id") @db.Uuid
  name               String
  format             String    @default("f11")
  gender             String?
  ageGroup           String?   @map("age_group")
  color              String?
  minPlayersPractice Int?      @map("min_players_practice") @db.SmallInt
  settings           Json      @default("{}")
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  club                Club                 @relation(fields: [clubId], references: [id])
  categoryMemberships CategoryMembership[]
  eventCategories     EventCategory[]

  @@unique([id, clubId])
  @@index([clubId])
  @@map("categories")
}

model ClubMembership {
  id                 String    @id @default(uuid(7)) @db.Uuid
  clubId             String    @map("club_id") @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  isOwner            Boolean   @default(false) @map("is_owner")
  isAdmin            Boolean   @default(false) @map("is_admin")
  status             String    @default("active")
  managedFirstName   String?   @map("managed_first_name")
  managedLastName    String?   @map("managed_last_name")
  managedNickname    String?   @map("managed_nickname")
  managedBirthdate   DateTime? @map("managed_birthdate") @db.Date
  contactEmail       String?   @map("contact_email") @db.Citext
  contactPhone       String?   @map("contact_phone")
  primaryPosition    String?   @map("primary_position")
  secondaryPositions String[]  @default([]) @map("secondary_positions")
  jerseyNumber       Int?      @map("jersey_number") @db.SmallInt
  // TODO(AUTH-10): add dominant_foot once the glossary lists its values.
  joinedAt           DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  removedAt          DateTime? @map("removed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  club                Club                 @relation(fields: [clubId], references: [id])
  user                User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  categoryMemberships CategoryMembership[]
  eventInvitees       EventInvitee[]       @relation("InviteeMembership")
  proxyRsvps          EventInvitee[]       @relation("RsvpSetBy")

  @@unique([id, clubId])
  @@unique([clubId, userId])
  @@unique([clubId], map: "club_memberships_one_owner_per_club", where: raw("is_owner"))
  @@index([userId])
  @@map("club_memberships")
}

model CategoryMembership {
  id               String    @id @default(uuid(7)) @db.Uuid
  clubId           String    @map("club_id") @db.Uuid
  categoryId       String    @map("category_id") @db.Uuid
  clubMembershipId String    @map("club_membership_id") @db.Uuid
  staffRole        String?   @map("staff_role")
  staffTitle       String?   @map("staff_title")
  isPlayer         Boolean   @default(false) @map("is_player")
  startsOn         DateTime  @map("starts_on") @db.Date
  endsOn           DateTime? @map("ends_on") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  club           Club           @relation(fields: [clubId], references: [id])
  category       Category       @relation(fields: [categoryId, clubId], references: [id, clubId])
  clubMembership ClubMembership @relation(fields: [clubMembershipId, clubId], references: [id, clubId])

  @@index([categoryId, endsOn])
  @@index([clubMembershipId])
  @@index([clubId])
  @@map("category_memberships")
}

model Venue {
  id         String    @id @default(uuid(7)) @db.Uuid
  clubId     String    @map("club_id") @db.Uuid
  name       String
  address    String?
  mapsUrl    String?   @map("maps_url")
  lat        Float?
  lng        Float?
  notes      String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  club   Club    @relation(fields: [clubId], references: [id])
  events Event[]

  @@unique([id, clubId])
  @@index([clubId])
  @@map("venues")
}

model Event {
  id                  String    @id @default(uuid(7)) @db.Uuid
  clubId              String    @map("club_id") @db.Uuid
  // TODO(EVT-02): add series_id together with the event_series table.
  type                String
  title               String?
  notes               String?
  startsAt            DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime  @map("ends_at") @db.Timestamptz(6)
  meetAt              DateTime? @map("meet_at") @db.Timestamptz(6)
  venueId             String?   @map("venue_id") @db.Uuid
  locationText        String?   @map("location_text")
  opponent            String?
  homeAway            String?   @map("home_away")
  competition         String?
  rsvpDeadlineAt      DateTime  @map("rsvp_deadline_at") @db.Timestamptz(6)
  rsvpLocked          Boolean   @default(false) @map("rsvp_locked")
  remindersEnabled    Boolean   @default(true) @map("reminders_enabled")
  shareToken          String    @unique @map("share_token")
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy         String?   @map("cancelled_by") @db.Uuid
  cancelMessage       String?   @map("cancel_message")
  isBackfill          Boolean   @default(false) @map("is_backfill")
  rollCallCompletedAt DateTime? @map("roll_call_completed_at") @db.Timestamptz(6)
  rollCallCompletedBy String?   @map("roll_call_completed_by") @db.Uuid
  overriddenFields    String[]  @default([]) @map("overridden_fields")
  version             Int       @default(1)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  club            Club            @relation(fields: [clubId], references: [id])
  venue           Venue?          @relation(fields: [venueId, clubId], references: [id, clubId])
  eventCategories EventCategory[]
  invitees        EventInvitee[]

  @@unique([id, clubId])
  @@index([clubId, startsAt])
  @@index([venueId])
  @@map("events")
}

model EventCategory {
  eventId    String   @map("event_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  clubId     String   @map("club_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  club     Club     @relation(fields: [clubId], references: [id])
  event    Event    @relation(fields: [eventId, clubId], references: [id, clubId])
  category Category @relation(fields: [categoryId, clubId], references: [id, clubId])

  @@id([eventId, categoryId])
  @@index([categoryId, eventId])
  @@index([clubId])
  @@map("event_categories")
}

model EventInvitee {
  id                   String    @id @default(uuid(7)) @db.Uuid
  eventId              String    @map("event_id") @db.Uuid
  clubId               String    @map("club_id") @db.Uuid
  clubMembershipId     String    @map("club_membership_id") @db.Uuid
  source               String
  rsvpStatus           String    @default("pending") @map("rsvp_status")
  rsvpReason           String?   @map("rsvp_reason")
  rsvpNote             String?   @map("rsvp_note")
  arrivingLate         Boolean   @default(false) @map("arriving_late")
  firstRespondedAt     DateTime? @map("first_responded_at") @db.Timestamptz(6)
  respondedAt          DateTime? @map("responded_at") @db.Timestamptz(6)
  rsvpIsLate           Boolean   @default(false) @map("rsvp_is_late")
  rsvpSetBy            String?   @map("rsvp_set_by") @db.Uuid
  attendanceStatus     String?   @map("attendance_status")
  absenceJustified     Boolean?  @map("absence_justified")
  attendanceRecordedBy String?   @map("attendance_recorded_by") @db.Uuid
  attendanceRecordedAt DateTime? @map("attendance_recorded_at") @db.Timestamptz(6)
  removedAt            DateTime? @map("removed_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  club                Club            @relation(fields: [clubId], references: [id])
  event               Event           @relation(fields: [eventId, clubId], references: [id, clubId])
  clubMembership      ClubMembership  @relation("InviteeMembership", fields: [clubMembershipId, clubId], references: [id, clubId])
  rsvpSetByMembership ClubMembership? @relation("RsvpSetBy", fields: [rsvpSetBy, clubId], references: [id, clubId])
  rsvpChanges         RsvpChange[]

  @@unique([id, clubId])
  @@unique([eventId, clubMembershipId])
  @@index([clubMembershipId, eventId])
  @@index([eventId, rsvpStatus])
  @@index([rsvpSetBy], where: raw("rsvp_set_by IS NOT NULL"))
  @@index([clubId])
  @@map("event_invitees")
}

model RsvpChange {
  id             String   @id @default(uuid(7)) @db.Uuid
  eventInviteeId String   @map("event_invitee_id") @db.Uuid
  clubId         String   @map("club_id") @db.Uuid
  fromStatus     String   @map("from_status")
  toStatus       String   @map("to_status")
  reason         String?
  arrivingLate   Boolean  @default(false) @map("arriving_late")
  source         String
  changedBy      String?  @map("changed_by") @db.Uuid
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  afterDeadline  Boolean  @default(false) @map("after_deadline")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  club         Club         @relation(fields: [clubId], references: [id])
  eventInvitee EventInvitee @relation(fields: [eventInviteeId, clubId], references: [id, clubId])

  @@index([eventInviteeId, changedAt])
  @@index([clubId])
  @@map("rsvp_changes")
}
