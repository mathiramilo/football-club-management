# Origin of the API the web app talks to. Its WEB_ORIGINS must list this app's origin.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Social sign-in buttons to show, comma-separated: google, apple. The API needs their secrets.
NEXT_PUBLIC_SOCIAL_SIGN_IN=
# Origin this app is served from; makes the link preview URLs absolute.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Universal links and App Links for /e, /j and /c. The app IDs are the bundle IDs of the builds this
# environment serves (also their Android package names); the fingerprints are the SHA-256 of their
# Android signing certificates. Leave empty locally.
APPLE_TEAM_ID=
APP_LINKS_APP_IDS=
ANDROID_CERT_FINGERPRINTS=
# Sentry stays off until a DSN is set. Builds upload source maps when SENTRY_AUTH_TOKEN, SENTRY_ORG and
# SENTRY_PROJECT are set too.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
