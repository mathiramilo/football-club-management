# Origin of the API the app talks to. On a device, use your machine's LAN address instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:3001
# OAuth client IDs for native Google sign-in; leave empty to hide the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Apple developer team ID. Sign in with Apple needs code signing, so iOS builds need it even on the simulator.
APPLE_TEAM_ID=
# Web origin that serves /e, /j and /c; sets the universal links and App Links. Leave empty locally.
EXPO_PUBLIC_WEB_URL=
# Sentry starts only when a DSN is set. Builds upload source maps when SENTRY_AUTH_TOKEN is set too.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# EAS project ID, from `eas init`; turns on EAS Update.
EAS_PROJECT_ID=
