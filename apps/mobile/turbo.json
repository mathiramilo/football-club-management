{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["APP_VARIANT", "EXPO_PUBLIC_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "interactive": true,
      "passThroughEnv": ["APP_VARIANT", "EXPO_PUBLIC_*"]
    }
  }
}
