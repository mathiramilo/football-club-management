{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["NEXT_TELEMETRY_DISABLED", "EXPO_NO_TELEMETRY"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["db:generate"]
    },
    "typecheck": {
      "dependsOn": ["db:generate"]
    },
    "test": {
      "dependsOn": ["db:generate"],
      "outputs": [],
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "dev": {
      "dependsOn": ["db:generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "PORT",
        "SHUTDOWN_DRAIN_MS",
        "MAILPIT_URL",
        "EMAIL_FROM",
        "API_BASE_URL",
        "BETTER_AUTH_SECRET",
        "WEB_ORIGINS",
        "GOOGLE_CLIENT_IDS",
        "APPLE_CLIENT_IDS",
        "AUTH_RATE_LIMIT_ENABLED",
        "AUTH_TRUSTED_PROXIES"
      ]
    }
  }
}
